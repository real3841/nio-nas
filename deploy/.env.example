# NIO-Dash · NAS 配置示例
# 复制为 deploy/.env 后填写；该文件含密钥，权限保持 600，且已被 .gitignore 忽略。

# ── 车辆基础接口（必需）─────────────────────────────────────────
# 蔚来 App 抓包得到，形如 "2.01v..."，只填 Bearer 部分，不要带 "Bearer " 前缀
NIO_ACCESS_TOKEN=

# 接口模式：widget = 免签名网关（推荐）；full = 带签名地址
NIO_API_MODE=widget

# ── 换电 / 签到（可选，按需填写）────────────────────────────────
# 换电订单接口需要签名，可直接粘贴抓到的完整请求地址与请求头
NIO_CHANGE_API_URL=
NIO_CHANGE_API_HEADERS=
NIO_CHANGE_ACCESS_TOKEN=

NIO_CHECKIN_API_URL=
NIO_CHECKIN_ACCESS_TOKEN=

# ── 高德（可选）────────────────────────────────────────────────
# 用于地图底图、逆地理编码；没有时自动降级
NIO_AMAP_WEB_SERVICE_KEY=
NIO_AMAP_JS_KEY=
NIO_AMAP_JS_SECURITY_CODE=

# ── 运行参数（都有默认值）──────────────────────────────────────
# NIO_DATA_DIR=/workspace/nio-dash/data
# NIO_WEB_PORT=8788
# NIO_API_PORT=8789

# 轮询间隔（秒）
# NIO_POLL_INTERVAL=3600
# NIO_VEHICLE_POLL_DRIVING_SEC=900
# NIO_VEHICLE_POLL_DAY_SEC=1800
# NIO_VEHICLE_POLL_NIGHT_SEC=3600

# ── 备份（可选）────────────────────────────────────────────────
# NIO_BACKUP_DIR=/workspace/nio-dash/backups

# ── 告警（可选）────────────────────────────────────────────────
# 通用 Webhook（POST JSON）与企业微信机器人二选一或都填
NIO_ALERT_WEBHOOK_URL=
NIO_ALERT_WECOM_URL=
